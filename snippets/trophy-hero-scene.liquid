<div class="trophy-hero-scene" aria-hidden="true">
  <script type="module" src="https://unpkg.com/@google/model-viewer@4.0.0/dist/model-viewer.min.js"></script>
  <div class="trophy-hero-scene__grain"></div>
  <div class="trophy-hero-scene__halo trophy-hero-scene__halo--one"></div>
  <div class="trophy-hero-scene__halo trophy-hero-scene__halo--two"></div>
  <div class="trophy-hero-scene__orbit trophy-hero-scene__orbit--one"></div>
  <div class="trophy-hero-scene__orbit trophy-hero-scene__orbit--two"></div>
  <div class="trophy-hero-scene__spark trophy-hero-scene__spark--one"></div>
  <div class="trophy-hero-scene__spark trophy-hero-scene__spark--two"></div>
  <div class="trophy-hero-scene__spark trophy-hero-scene__spark--three"></div>

  <div class="trophy-hero-scene__stage">
    <div class="trophy-hero trophy-hero--left">
      <svg viewBox="0 0 220 360" role="presentation">
        <defs>
          <linearGradient id="gold-left" x1="0" x2="1" y1="0" y2="1">
            <stop offset="0" stop-color="#fff3a6" />
            <stop offset="0.24" stop-color="#d89b21" />
            <stop offset="0.5" stop-color="#fff0a0" />
            <stop offset="0.76" stop-color="#a76608" />
            <stop offset="1" stop-color="#f6cf58" />
          </linearGradient>
          <linearGradient id="gold-left-dark" x1="0" x2="0" y1="0" y2="1">
            <stop offset="0" stop-color="#f4ce58" />
            <stop offset="1" stop-color="#87500a" />
          </linearGradient>
          <filter id="shadow-left"><feDropShadow dx="0" dy="12" stdDeviation="8" flood-color="#000" flood-opacity=".42" /></filter>
        </defs>
        <g filter="url(#shadow-left)">
          <path d="M74 60C45 51 25 60 16 76c18 0 35 11 43 31 6 15 18 24 34 25l-4-26C80 92 75 76 74 60Z" fill="url(#gold-left-dark)" stroke="#ffe789" stroke-width="3" />
          <path d="M146 60c29-9 49 0 58 16-18 0-35 11-43 31-6 15-18 24-34 25l4-26c9-14 14-30 15-46Z" fill="url(#gold-left-dark)" stroke="#ffe789" stroke-width="3" />
          <path d="M70 48h80l-8 27c-5 17-14 27-32 31-18-4-27-14-32-31Z" fill="url(#gold-left)" stroke="#ffe789" stroke-width="3" />
          <path d="M82 102h56l-8 112H90Z" fill="url(#gold-left)" stroke="#b8750c" stroke-width="3" />
          <path d="M72 213h76l13 19H59Z" fill="url(#gold-left-dark)" stroke="#ffe789" stroke-width="3" />
          <path d="M54 233h112l12 35H42Z" fill="url(#gold-left)" stroke="#b8750c" stroke-width="3" />
          <path d="M49 268h122l-8 18H57Z" fill="#8f560b" stroke="#f8d762" stroke-width="3" />
          <path d="M86 127h48v46H86Z" fill="#fff1a0" opacity=".42" />
        </g>
      </svg>
    </div>

    <div class="trophy-hero trophy-hero--center">
      <model-viewer
        class="trophy-hero__model"
        src="{{ 'trophy.glb' | asset_url }}"
        camera-orbit="0deg 78deg 2.35m"
        field-of-view="28deg"
        auto-rotate
        rotation-per-second="12deg"
        interaction-prompt="none"
        environment-image="neutral"
        tone-mapping="neutral"
        exposure="1.15"
        shadow-intensity="1"
        shadow-softness="0.9"
        loading="eager"
        reveal="auto"
        alt="Gold trophy"
      ></model-viewer>
      <svg viewBox="0 0 220 360" role="presentation">
        <defs>
          <linearGradient id="gold-center" x1="0" x2="1" y1="0" y2="1">
            <stop offset="0" stop-color="#fff6b7" />
            <stop offset="0.2" stop-color="#e2a322" />
            <stop offset="0.45" stop-color="#fff6b4" />
            <stop offset="0.7" stop-color="#b87508" />
            <stop offset="1" stop-color="#ffdc65" />
          </linearGradient>
          <linearGradient id="gold-center-dark" x1="0" x2="0" y1="0" y2="1">
            <stop offset="0" stop-color="#ffd95b" />
            <stop offset="1" stop-color="#9a5c08" />
          </linearGradient>
          <filter id="shadow-center"><feDropShadow dx="0" dy="18" stdDeviation="10" flood-color="#000" flood-opacity=".5" /></filter>
        </defs>
        <g filter="url(#shadow-center)">
          <path d="M68 49h84l-9 32c-6 22-16 35-33 41-17-6-27-19-33-41Z" fill="url(#gold-center)" stroke="#fff0a1" stroke-width="4" />
          <path d="M68 60C35 50 14 63 8 84c22-1 40 14 45 37 4 17 17 28 37 30l-4-27c-10-16-16-38-18-64Z" fill="url(#gold-center-dark)" stroke="#ffea85" stroke-width="4" />
          <path d="M152 60c33-10 54 3 60 24-22-1-40 14-45 37-4 17-17 28-37 30l4-27c10-16 16-38 18-64Z" fill="url(#gold-center-dark)" stroke="#ffea85" stroke-width="4" />
          <path d="M79 114h62l-8 111H87Z" fill="url(#gold-center)" stroke="#b87508" stroke-width="4" />
          <path d="M88 126h44v57H88Z" fill="#fff5b0" opacity=".55" />
          <path d="M66 225h88l15 22H51Z" fill="url(#gold-center-dark)" stroke="#ffea85" stroke-width="4" />
          <path d="M47 247h126l14 39H33Z" fill="url(#gold-center)" stroke="#b87508" stroke-width="4" />
          <path d="M39 286h142l-8 20H47Z" fill="#8c5307" stroke="#ffe681" stroke-width="4" />
        </g>
      </svg>
    </div>

    <div class="trophy-hero trophy-hero--right">
      <svg viewBox="0 0 220 360" role="presentation">
        <defs>
          <linearGradient id="gold-right" x1="0" x2="1" y1="0" y2="1">
            <stop offset="0" stop-color="#fff3a6" />
            <stop offset="0.24" stop-color="#d89b21" />
            <stop offset="0.5" stop-color="#fff0a0" />
            <stop offset="0.76" stop-color="#a76608" />
            <stop offset="1" stop-color="#f6cf58" />
          </linearGradient>
          <linearGradient id="gold-right-dark" x1="0" x2="0" y1="0" y2="1">
            <stop offset="0" stop-color="#f4ce58" />
            <stop offset="1" stop-color="#87500a" />
          </linearGradient>
          <filter id="shadow-right"><feDropShadow dx="0" dy="12" stdDeviation="8" flood-color="#000" flood-opacity=".42" /></filter>
        </defs>
        <g filter="url(#shadow-right)">
          <path d="M74 60C45 51 25 60 16 76c18 0 35 11 43 31 6 15 18 24 34 25l-4-26C80 92 75 76 74 60Z" fill="url(#gold-right-dark)" stroke="#ffe789" stroke-width="3" />
          <path d="M146 60c29-9 49 0 58 16-18 0-35 11-43 31-6 15-18 24-34 25l4-26c9-14 14-30 15-46Z" fill="url(#gold-right-dark)" stroke="#ffe789" stroke-width="3" />
          <path d="M70 48h80l-8 27c-5 17-14 27-32 31-18-4-27-14-32-31Z" fill="url(#gold-right)" stroke="#ffe789" stroke-width="3" />
          <path d="M82 102h56l-8 112H90Z" fill="url(#gold-right)" stroke="#b8750c" stroke-width="3" />
          <path d="M72 213h76l13 19H59Z" fill="url(#gold-right-dark)" stroke="#ffe789" stroke-width="3" />
          <path d="M54 233h112l12 35H42Z" fill="url(#gold-right)" stroke="#b8750c" stroke-width="3" />
          <path d="M49 268h122l-8 18H57Z" fill="#8f560b" stroke="#f8d762" stroke-width="3" />
          <path d="M86 127h48v46H86Z" fill="#fff1a0" opacity=".42" />
        </g>
      </svg>
    </div>
  </div>

  <div class="trophy-hero-scene__caption">M.B. &amp; B. / 2026</div>
</div>

{% stylesheet %}
  .trophy-hero-scene {
    position: absolute;
    inset: 0;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(circle at 50% 42%, rgb(255 205 72 / 24%), transparent 18%),
      radial-gradient(circle at 50% 100%, rgb(202 147 31 / 22%), transparent 48%),
      linear-gradient(135deg, #10151a 0%, #17242a 46%, #0c1014 100%);
  }

  .trophy-hero-scene::before,
  .trophy-hero-scene::after {
    content: '';
    position: absolute;
    inset: -20%;
    pointer-events: none;
  }

  .trophy-hero-scene::before {
    background: conic-gradient(from 210deg at 50% 48%, transparent 0deg, rgb(255 209 89 / 13%) 18deg, transparent 42deg, transparent 145deg, rgb(255 209 89 / 10%) 164deg, transparent 190deg);
    animation: trophy-light-sweep 14s linear infinite;
  }

  .trophy-hero-scene::after {
    background: linear-gradient(110deg, transparent 32%, rgb(255 255 255 / 5%) 45%, transparent 58%);
    transform: translateX(-30%);
    animation: trophy-glint 8s ease-in-out infinite;
  }

  .trophy-hero-scene__grain {
    position: absolute;
    inset: 0;
    opacity: .18;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.45'/%3E%3C/svg%3E");
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  .trophy-hero-scene__stage {
    position: absolute;
    inset: 8% 8% 7%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    perspective: 900px;
  }

  .trophy-hero-scene__stage::after {
    content: '';
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: 1%;
    height: 13%;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgb(255 198 60 / 38%), transparent 68%);
    filter: blur(18px);
    transform: rotateX(64deg);
  }

  .trophy-hero {
    position: relative;
    z-index: 1;
    width: min(24vw, 300px);
    filter: drop-shadow(0 22px 18px rgb(0 0 0 / 32%));
    transform-origin: center bottom;
    animation: trophy-float 5.8s ease-in-out infinite;
  }

  .trophy-hero svg { width: 100%; height: auto; }
  .trophy-hero__model { display: none; width: 100%; height: 100%; min-height: 260px; background: transparent; --poster-color: transparent; }
  .trophy-hero__model:defined { display: block; }
  .trophy-hero__model:defined + svg { display: none; }
  .trophy-hero--left { margin-right: -3%; transform: translateY(8%) rotateY(18deg) rotateZ(-4deg); animation-delay: -1.5s; }
  .trophy-hero--center { z-index: 2; width: min(31vw, 390px); animation-delay: -.4s; }
  .trophy-hero--right { margin-left: -3%; transform: translateY(9%) rotateY(-18deg) rotateZ(4deg); animation-delay: -3s; }

  .trophy-hero-scene__halo {
    position: absolute;
    left: 50%;
    top: 14%;
    width: min(48vw, 620px);
    aspect-ratio: 1;
    border: 1px solid rgb(255 219 112 / 25%);
    border-radius: 50%;
    transform: translateX(-50%);
    box-shadow: 0 0 80px rgb(255 195 48 / 17%), inset 0 0 80px rgb(255 195 48 / 8%);
  }

  .trophy-hero-scene__halo--two { width: min(37vw, 480px); top: 20%; border-color: rgb(255 243 174 / 18%); animation: trophy-pulse 4s ease-in-out infinite; }
  .trophy-hero-scene__orbit { position: absolute; left: 50%; top: 36%; width: min(56vw, 720px); aspect-ratio: 2.8; border: 1px solid rgb(255 219 112 / 18%); border-radius: 50%; transform: translate(-50%, -50%) rotate(-18deg); }
  .trophy-hero-scene__orbit--two { width: min(45vw, 580px); transform: translate(-50%, -50%) rotate(24deg); border-color: rgb(255 243 174 / 13%); }
  .trophy-hero-scene__spark { position: absolute; width: 5px; height: 5px; border-radius: 50%; background: #ffe18a; box-shadow: 0 0 15px 4px rgb(255 211 84 / 75%); animation: trophy-spark 3.8s ease-in-out infinite; }
  .trophy-hero-scene__spark--one { left: 21%; top: 24%; }
  .trophy-hero-scene__spark--two { right: 20%; top: 30%; animation-delay: -1.6s; }
  .trophy-hero-scene__spark--three { left: 76%; top: 64%; animation-delay: -2.7s; }
  .trophy-hero-scene__caption { position: absolute; left: 50%; bottom: 4%; transform: translateX(-50%); color: rgb(255 231 148 / 72%); font: 600 10px/1 var(--font-body--family); letter-spacing: .22em; white-space: nowrap; }

  @keyframes trophy-float { 0%, 100% { translate: 0 0; } 50% { translate: 0 -12px; } }
  @keyframes trophy-light-sweep { to { transform: rotate(360deg); } }
  @keyframes trophy-glint { 0%, 100% { translate: -20% 0; opacity: 0; } 45%, 60% { opacity: 1; } }
  @keyframes trophy-pulse { 0%, 100% { scale: .96; opacity: .55; } 50% { scale: 1.04; opacity: 1; } }
  @keyframes trophy-spark { 0%, 100% { opacity: .25; scale: .7; } 50% { opacity: 1; scale: 1.4; } }

  @media screen and (max-width: 749px) {
    .trophy-hero-scene__stage { inset: 15% -8% 8%; }
    .trophy-hero { width: 36vw; }
    .trophy-hero--center { width: 50vw; }
    .trophy-hero--left { margin-right: -8%; }
    .trophy-hero--right { margin-left: -8%; }
    .trophy-hero-scene__halo { width: 90vw; top: 20%; }
    .trophy-hero-scene__halo--two { width: 70vw; top: 25%; }
    .trophy-hero-scene__orbit { width: 115vw; top: 42%; }
    .trophy-hero-scene__orbit--two { width: 95vw; }
  }

  @media (prefers-reduced-motion: reduce) {
    .trophy-hero-scene *, .trophy-hero-scene::before, .trophy-hero-scene::after { animation: none !important; }
  }
{% endstylesheet %}
